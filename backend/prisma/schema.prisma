generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  GYM_ADMIN
  STAFF
  TRAINER
  MEMBER
}

enum GymStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum SaaSPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SaaSStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SaasBillingPeriod {
  MONTHLY
  YEARLY
}

/// Lifecycle of one manual-UPI subscription purchase attempt. Deliberately a new
/// type rather than extra values on SaaSStatus: payment state and entitlement
/// state are different things, and Postgres cannot add an enum value and use it
/// in the same migration.
enum SaasPaymentStatus {
  AWAITING_PAYMENT
  SUBMITTED
  CONFIRMED
  REJECTED
  CANCELLED
}

enum MembershipType {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  CUSTOM
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
  FROZEN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum CheckInMethod {
  QR_CODE
  MANUAL
  BIOMETRIC
}

enum AttendanceCloseReason {
  NORMAL
  AUTO_CHECKOUT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  RAZORPAY
  BANK_TRANSFER
  UPI
}

enum PaymentType {
  MEMBERSHIP
  PT_SESSION
  SUPPLEMENT
  DIET_PLAN
  WORKOUT_PLAN
  OTHER
}

enum NotificationType {
  MEMBERSHIP_EXPIRY
  PAYMENT_DUE
  GENERAL
  OFFER
  SYSTEM
  ATTENDANCE
  LEAVE_REQUEST
  REFERRAL
  WINBACK
}

enum EnquirySource {
  WALK_IN
  PHONE
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum LeaveType {
  SICK
  CASUAL
  EMERGENCY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EnquiryStatus {
  NEW
  CONTACTED
  INTERESTED
  CONVERTED
  NOT_INTERESTED
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
  LOGIN_2FA
}

enum ExpenseCategory {
  TRAINER_SALARY
  STAFF_SALARY
  ELECTRICITY
  WATER
  RENT
  EQUIPMENT_MAINTENANCE
  INTERNET
  MARKETING
  OTHER
}

enum PtSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SupplementOrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum ChatType {
  /// Legacy shared "gym desk" thread. Migrated to DIRECT; kept so old rows read.
  GYM
  /// Private 1:1 thread between two people in the same gym.
  DIRECT
  /// Gym admin ↔ super admin.
  SUPPORT
  /// Many-to-many room inside one gym. Only a gym admin creates one; every
  /// active participant may post. Participants live in ChatParticipant.
  GROUP
}

/// Role.STAFF is one role to the guards; this splits what that person does.
enum StaffType {
  /// Signs members up, runs the desk, sees who owes money.
  FRONT_DESK
  /// Attendance, leave and salary only — no member data, no money.
  CLEANING
}

enum ChatParticipantRole {
  /// May rename the group, add and remove people, and delete it.
  OWNER
  /// May read and post.
  MEMBER
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Gym {
  id                      String     @id @default(uuid())
  name                    String
  slug                    String     @unique
  email                   String     @unique
  phone                   String
  address                 String
  city                    String
  state                   String
  pincode                 String
  country                 String     @default("India")
  timezone                String     @default("Asia/Kolkata")
  logo                    String?
  coverImage              String?
  description             String?
  website                 String?
  gstin                   String?
  amenities               String[]
  openTime                String?
  closeTime               String?
  workingDays             String[]
  maxMembers              Int        @default(100)
  status                  GymStatus  @default(PENDING)
  saasPlan                SaaSPlan   @default(STARTER)
  saasStatus              SaaSStatus @default(TRIAL)
  saasExpiresAt           DateTime?
  razorpayAccountId       String?
  renewalRemindersEnabled Boolean    @default(true)
  // Manual UPI payout details — member payments are collected as a plain UPI
  // QR/intent straight to this VPA (no gateway, no KYC), gym admin confirms
  // receipt manually after checking their own bank/UPI app.
  payoutUpiVpa            String?
  payoutAccountHolder     String?
  payoutBankAccountNumber String?
  payoutBankIfsc          String?
  payoutPhone             String?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  deletedAt               DateTime?

  users                User[]
  members              Member[]
  trainers             Trainer[]
  staffs               Staff[]
  membershipPlans      MembershipPlan[]
  memberSubscriptions  MemberSubscription[]
  attendance           Attendance[]
  occupancySnapshots   OccupancySnapshot[]
  payments             Payment[]
  workoutPlans         WorkoutPlan[]
  dietPlans            DietPlan[]
  notifications        Notification[]
  supportTickets       SupportTicket[]
  enquiries            Enquiry[]
  branches             Branch[]
  auditLogs            AuditLog[]
  expenses             Expense[]
  gymSubscriptions     GymSubscription[]
  subscriptionPayments GymSubscriptionPayment[]
  ptSessions           PtSession[]
  leaveRequests        LeaveRequest[]
  chatConversations    ChatConversation[]
  supplements          Supplement[]
  supplementOrders     SupplementOrder[]
  promoCodes           PromoCode[]
  invoices             Invoice[]
  salaryPayouts        SalaryPayout[]

  @@index([status])
  @@index([saasStatus])
  @@map("gyms")
}

model SaaSSubscriptionPlan {
  id             String   @id @default(uuid())
  name           String   @unique
  plan           SaaSPlan @unique
  monthlyPrice   Float
  yearlyPrice    Float
  maxMembers     Int
  maxTrainers    Int
  maxStaff       Int
  maxBranches    Int
  features       String[]
  razorpayPlanId String?
  isActive       Boolean  @default(true)
  commissionPct  Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  gymSubscriptions     GymSubscription[]
  subscriptionPayments GymSubscriptionPayment[]

  @@map("saas_subscription_plans")
}

/// Authoritative record of what a gym is entitled to. Gym.saasPlan/saasStatus/
/// saasExpiresAt are a denormalized read cache of this table and are written
/// ONLY by GymSubscriptionsService.syncGymCache — never by a gym update route.
model GymSubscription {
  id                     String            @id @default(uuid())
  gymId                  String
  planId                 String
  status                 SaaSStatus        @default(TRIAL)
  billingPeriod          SaasBillingPeriod @default(MONTHLY)
  startDate              DateTime
  endDate                DateTime
  amount                 Float
  activatedAt            DateTime?
  cancelledAt            DateTime?
  cancelReason           String?
  /// Set when an upgrade replaces this term early.
  supersededById         String?
  /// Stamped when the single pre-expiry reminder goes out, so the daily sweep
  /// sends it exactly once rather than every day inside the window.
  expiryReminderSentAt   DateTime?
  /// UPI_MANUAL | TRIAL | SUPER_ADMIN_GRANT | MIGRATION
  source                 String            @default("UPI_MANUAL")
  grantedByUserId        String?
  razorpayOrderId        String?
  razorpayPaymentId      String?
  razorpaySubscriptionId String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  gym      Gym                      @relation(fields: [gymId], references: [id])
  plan     SaaSSubscriptionPlan     @relation(fields: [planId], references: [id])
  payments GymSubscriptionPayment[]

  @@index([gymId])
  @@index([gymId, status])
  @@index([status, endDate])
  @@map("gym_subscriptions")
}

/// One row per purchase attempt: the gym admin's subscription request AND the
/// manual-UPI payment record for it. Mirrors how Payment doubles as both for
/// member payments. Kept out of the Payment table on purpose — Payment.memberId
/// is required and Payment.gymId means "money this gym collected", which SaaS
/// revenue is not.
model GymSubscriptionPayment {
  id                String            @id @default(uuid())
  gymId             String
  planId            String
  billingPeriod     SaasBillingPeriod
  amount            Float
  /// Human-readable code the gym admin puts in the UPI note, e.g. AB-SUB-7F3K2.
  referenceCode     String            @unique
  status            SaasPaymentStatus @default(AWAITING_PAYMENT)
  /// Snapshot of the platform VPA at request time, so old rows stay explainable.
  payeeVpa          String
  upiReference      String?
  requestedByUserId String
  submittedAt       DateTime?
  confirmedAt       DateTime?
  confirmedByUserId String?
  bankReference     String?
  rejectedAt        DateTime?
  rejectedByUserId  String?
  rejectionReason   String?
  subscriptionId    String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  gym          Gym                  @relation(fields: [gymId], references: [id])
  plan         SaaSSubscriptionPlan @relation(fields: [planId], references: [id])
  subscription GymSubscription?     @relation(fields: [subscriptionId], references: [id])

  @@index([status, submittedAt])
  @@index([gymId, createdAt])
  @@map("gym_subscription_payments")
}

/// Single-row platform configuration. The platform's own UPI VPA lives here:
/// Gym.payoutUpiVpa is where a gym COLLECTS from its members, which is the
/// wrong payee when the gym is the one paying us.
model PlatformSettings {
  id              String   @id @default("singleton")
  upiVpa          String?
  upiPayeeName    String?
  trialDays       Int      @default(14)
  /// 0 = a plan goes inactive the moment it expires. Raise it to give gyms a
  /// cushion after the end date.
  graceDays       Int      @default(0)
  supportEmail    String?
  gstPct          Float    @default(0)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("platform_settings")
}

model User {
  id               String    @id @default(uuid())
  gymId            String?
  email            String    @unique
  phone            String?   @unique
  password         String
  firstName        String
  lastName         String
  role             Role
  avatar           String?
  dateOfBirth      DateTime?
  gender           String?
  address          String?
  city             String?
  state            String?
  pincode          String?
  country          String?   @default("India")
  timezone         String?
  emergencyContact String?
  isActive         Boolean   @default(true)
  isEmailVerified  Boolean   @default(false)
  isPhoneVerified  Boolean   @default(false)
  lastLoginAt      DateTime?
  refreshToken     String?
  // Manual UPI payout — same record-only model as Gym's: gym admin pays salary
  // straight to this VPA via their own banking, then marks the payout Paid.
  payoutUpiVpa     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  gym               Gym?               @relation(fields: [gymId], references: [id])
  member            Member?
  trainer           Trainer?
  staff             Staff?
  salaryPayouts     SalaryPayout[]
  otpCodes          OtpCode[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  leaveRequests     LeaveRequest[]
  conversations     ChatConversation[] @relation("UserConversations")
  peerConversations ChatConversation[] @relation("PeerConversations")
  chatMessages      ChatMessage[]      @relation("SentChatMessages")
  chatParticipations ChatParticipant[] @relation("ChatParticipations")
  attendanceRecords Attendance[]       @relation("AttendanceUser")
  supplementOrders  SupplementOrder[]
  invoices          Invoice[]          @relation("UserInvoices")
  pushTokens        PushToken[]

  @@index([gymId])
  @@index([role])
  @@index([email])
  @@map("users")
}

model Member {
  id                   String    @id @default(uuid())
  userId               String    @unique
  gymId                String
  memberCode           String    @unique
  qrToken              String    @unique @default(uuid())
  bloodGroup           String?
  medicalConditions    String?
  fitnessGoals         String?
  profilePhoto         String?
  referralCode         String?   @unique
  referralCredit       Float     @default(0)
  referredById         String?
  joinDate             DateTime  @default(now())
  attendanceStreak     Int       @default(0)
  bestAttendanceStreak Int       @default(0)
  lastAttendanceDate   DateTime?
  /// How many sessions a week this member is aiming for. Drives the Home
  /// progress ring and the mid-week nudge.
  weeklyGoal           Int       @default(3)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  user                User                 @relation(fields: [userId], references: [id])
  gym                 Gym                  @relation(fields: [gymId], references: [id])
  referredBy          Member?              @relation("MemberReferrals", fields: [referredById], references: [id])
  referrals           Member[]             @relation("MemberReferrals")
  memberSubscriptions MemberSubscription[]
  attendance          Attendance[]
  payments            Payment[]
  workoutAssignments  WorkoutAssignment[]
  dietAssignments     DietAssignment[]
  progressLogs        ProgressLog[]
  dailyLogs           MemberDailyLog[]
  supplementPicks     SupplementAssignment[]
  activityRuns        ActivityRun[]
  trainerAssignments  TrainerAssignment[]
  ptSessions          PtSession[]

  @@index([gymId])
  @@index([memberCode])
  @@index([gymId, userId])
  @@index([gymId, deletedAt])
  @@map("members")
}

model Trainer {
  id              String    @id @default(uuid())
  userId          String    @unique
  gymId           String
  employeeId      String?
  specializations String[]
  certifications  String[]
  experience      Int       @default(0)
  bio             String?
  rating          Float     @default(0)
  hourlyRate      Float?
  isAvailable     Boolean   @default(true)
  joiningDate     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user              User                @relation(fields: [userId], references: [id])
  gym               Gym                 @relation(fields: [gymId], references: [id])
  memberAssignments TrainerAssignment[]
  workoutPlans      WorkoutPlan[]
  dietPlans         DietPlan[]
  ptSessions        PtSession[]

  @@index([gymId])
  @@map("trainers")
}

model Staff {
  id          String    @id @default(uuid())
  userId      String    @unique
  gymId       String
  employeeId  String?
  /// What this person actually does. `designation` is free text and always was;
  /// this is the field behaviour keys off — front desk signs members up and sees
  /// dues, cleaning staff do neither.
  staffType   StaffType @default(FRONT_DESK)
  designation String?
  department  String?
  joiningDate DateTime  @default(now())
  salary      Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id])
  gym  Gym  @relation(fields: [gymId], references: [id])

  @@index([gymId])
  @@map("staffs")
}

model TrainerAssignment {
  id         String   @id @default(uuid())
  trainerId  String
  memberId   String
  gymId      String
  assignedAt DateTime @default(now())
  isActive   Boolean  @default(true)
  notes      String?

  trainer Trainer @relation(fields: [trainerId], references: [id])
  member  Member  @relation(fields: [memberId], references: [id])

  @@unique([trainerId, memberId])
  @@index([gymId])
  @@map("trainer_assignments")
}

model MembershipPlan {
  id             String         @id @default(uuid())
  gymId          String
  name           String
  type           MembershipType
  durationMonths Int
  price          Float
  discount       Float          @default(0)
  features       String[]
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  gym           Gym                  @relation(fields: [gymId], references: [id])
  subscriptions MemberSubscription[]

  @@index([gymId])
  @@map("membership_plans")
}

model MemberSubscription {
  id            String           @id @default(uuid())
  memberId      String
  gymId         String
  planId        String
  status        MembershipStatus @default(PENDING)
  startDate     DateTime
  endDate       DateTime
  amount        Float
  autoRenew     Boolean          @default(false)
  remindersSent Int[]            @default([])
  freezeStart   DateTime?
  freezeEnd     DateTime?
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  member   Member         @relation(fields: [memberId], references: [id])
  gym      Gym            @relation(fields: [gymId], references: [id])
  plan     MembershipPlan @relation(fields: [planId], references: [id])
  payments Payment[]
  invoices Invoice[]

  @@index([memberId])
  @@index([gymId])
  @@index([status])
  @@index([endDate])
  @@index([gymId, status])
  @@index([gymId, endDate])
  @@map("member_subscriptions")
}

model Attendance {
  id              String                @id @default(uuid())
  userId          String?
  memberId        String?
  gymId           String
  checkInTime     DateTime              @default(now())
  checkOutTime    DateTime?
  durationMinutes Int?
  date            DateTime              @default(now()) @db.Date
  status          AttendanceStatus      @default(PRESENT)
  method          CheckInMethod         @default(MANUAL)
  closeReason     AttendanceCloseReason @default(NORMAL)
  notes           String?
  markedBy        String?
  deletedAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user   User?   @relation("AttendanceUser", fields: [userId], references: [id])
  member Member? @relation(fields: [memberId], references: [id])
  gym    Gym     @relation(fields: [gymId], references: [id])

  @@index([userId])
  @@index([memberId])
  @@index([gymId])
  @@index([date])
  @@index([gymId, checkInTime])
  @@index([gymId, memberId])
  @@map("attendance")
}

model OccupancySnapshot {
  id             String   @id @default(uuid())
  gymId          String
  occupancyCount Int
  createdAt      DateTime @default(now())

  gym Gym @relation(fields: [gymId], references: [id])

  @@index([gymId])
  @@index([gymId, createdAt])
  @@map("occupancy_snapshots")
}

model Payment {
  id                 String        @id @default(uuid())
  memberId           String
  gymId              String
  subscriptionId     String?
  type               PaymentType
  amount             Float
  status             PaymentStatus @default(PENDING)
  method             PaymentMethod @default(CASH)
  razorpayOrderId    String?
  razorpayPaymentId  String?
  memberConfirmedAt  DateTime?
  invoiceUrl         String?
  notes              String?
  promoCodeId        String?
  discountAmount     Float         @default(0)
  platformCommission Float         @default(0)
  dietPlanId         String?
  workoutPlanId      String?
  membershipPlanId   String?
  paidAt             DateTime?
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  member          Member              @relation(fields: [memberId], references: [id])
  gym             Gym                 @relation(fields: [gymId], references: [id])
  subscription    MemberSubscription? @relation(fields: [subscriptionId], references: [id])
  promoCode       PromoCode?          @relation(fields: [promoCodeId], references: [id])
  workoutPlan     WorkoutPlan?        @relation(fields: [workoutPlanId], references: [id])
  invoice         Invoice?
  supplementOrder SupplementOrder?

  @@index([memberId])
  @@index([gymId])
  @@index([status])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([paidAt])
  @@index([gymId, status])
  @@index([gymId, paidAt])
  @@map("payments")
}

model WorkoutPlan {
  id            String    @id @default(uuid())
  gymId         String
  trainerId     String?
  name          String
  goal          String
  difficulty    String    @default("BEGINNER")
  durationWeeks Int       @default(4)
  exercises     Json
  isAiGenerated Boolean   @default(false)
  isTemplate    Boolean   @default(false)
  isPremium     Boolean   @default(false)
  price         Float?
  durationDays  Int?
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  gym         Gym                 @relation(fields: [gymId], references: [id])
  trainer     Trainer?            @relation(fields: [trainerId], references: [id])
  assignments WorkoutAssignment[]
  payments    Payment[]

  @@index([gymId])
  @@map("workout_plans")
}

model WorkoutAssignment {
  id            String    @id @default(uuid())
  workoutPlanId String
  memberId      String
  gymId         String
  startDate     DateTime
  endDate       DateTime?
  isActive      Boolean   @default(true)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workoutPlan WorkoutPlan @relation(fields: [workoutPlanId], references: [id])
  member      Member      @relation(fields: [memberId], references: [id])

  @@index([gymId])
  @@index([memberId])
  @@map("workout_assignments")
}

model DietPlan {
  id            String    @id @default(uuid())
  gymId         String
  trainerId     String?
  name          String
  goal          String
  totalCalories Int?
  meals         Json
  restrictions  String[]
  isAiGenerated Boolean   @default(false)
  isTemplate    Boolean   @default(false)
  isPremium     Boolean   @default(false)
  price         Float?
  durationDays  Int?
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  gym         Gym              @relation(fields: [gymId], references: [id])
  trainer     Trainer?         @relation(fields: [trainerId], references: [id])
  assignments DietAssignment[]

  @@index([gymId])
  @@map("diet_plans")
}

model DietAssignment {
  id         String    @id @default(uuid())
  dietPlanId String
  memberId   String
  gymId      String
  startDate  DateTime
  endDate    DateTime?
  isActive   Boolean   @default(true)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  dietPlan DietPlan @relation(fields: [dietPlanId], references: [id])
  member   Member   @relation(fields: [memberId], references: [id])

  @@index([gymId])
  @@index([memberId])
  @@map("diet_assignments")
}

model ProgressLog {
  id         String   @id @default(uuid())
  memberId   String
  gymId      String
  weight     Float?
  height     Float?
  bmi        Float?
  bodyFat    Float?
  muscleMass Float?
  chest      Float?
  waist      Float?
  hips       Float?
  arms       Float?
  thighs     Float?
  photos     String[]
  notes      String?
  logDate    DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@map("progress_logs")
}

/// One row per member per day: the Home checklist ticks plus the lightweight
/// daily inputs (water, calories). Previously the checklist lived only in an
/// in-memory store on the device, so it was lost on restart and no trainer or
/// admin could ever see it.
model MemberDailyLog {
  id         String   @id @default(uuid())
  memberId   String
  gymId      String
  /// Local calendar day, stored date-only so a member's "today" is stable.
  date       DateTime @db.Date
  /// Checklist ticks keyed by item, e.g. { "workout": true, "diet": false }.
  items      Json     @default("{}")
  waterMl    Int      @default(0)
  caloriesIn Int?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, date])
  @@index([gymId, date])
  @@map("member_daily_logs")
}

/// A GPS-tracked run recorded from the mobile app (foreground tracking, v1).
model ActivityRun {
  id              String   @id @default(uuid())
  memberId        String
  gymId           String
  startedAt       DateTime
  endedAt         DateTime
