/// A chat thread.
///
/// DIRECT is a private 1:1 thread between `user` and `peer`, and the pair is
/// stored in a canonical order (userId < peerId) so a pair has exactly one row
/// whichever side opens it. SUPPORT is the gym admin ↔ super admin thread and
/// has no peer.
///
/// Unread counters follow the two sides, not roles: `unreadUser` is what
/// `userId` has not read, `unreadAdmin` what `peerId` has not read (the names
/// predate direct messages; see chat.service for the accessors).
model ChatConversation {
  id            String    @id @default(uuid())
  gymId         String
  userId        String
  peerId        String?
  type          ChatType  @default(DIRECT)
  /// GROUP only: the room's display name and picture.
  name          String?
  avatar        String?
  lastMessage   String?
  lastMessageAt DateTime  @default(now())
  unreadAdmin   Int       @default(0)
  unreadUser    Int       @default(0)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  gym          Gym               @relation(fields: [gymId], references: [id])
  user         User              @relation("UserConversations", fields: [userId], references: [id])
  peer         User?             @relation("PeerConversations", fields: [peerId], references: [id])
  messages     ChatMessage[]
  participants ChatParticipant[]

  @@unique([gymId, userId, peerId, type])
  @@index([gymId])
  @@index([type])
  @@index([peerId])
  @@index([gymId, type])
  @@map("chat_conversations")
}

/// Membership of a GROUP conversation, with that person's own unread counter.
/// The pair-shaped `unreadUser`/`unreadAdmin` columns on ChatConversation only
/// work for two sides, so a room counts unread here instead.
model ChatParticipant {
  id             String              @id @default(uuid())
  conversationId String
  userId         String
  role           ChatParticipantRole @default(MEMBER)
  unread         Int                 @default(0)
  lastReadAt     DateTime?
  joinedAt       DateTime            @default(now())
  /// Left or was removed. Kept rather than deleted so their messages still
  /// resolve to a name.
  isActive       Boolean             @default(true)

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation("ChatParticipations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, isActive])
  @@index([conversationId])
  @@map("chat_participants")
}

model ChatMessage {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String    @default("")
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  isRead         Boolean   @default(false)
  isDeleted      Boolean   @default(false)
  reactions      Json      @default("[]")
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation("SentChatMessages", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@map("chat_messages")
}

